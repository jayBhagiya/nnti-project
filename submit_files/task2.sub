project_dir = /path/to/nnti-project
data_dir = /path/to/large-storage/nnti-project
run_label = base
model_args =

universe = docker
docker_image = pytorch/pytorch:2.2.2-cuda11.8-cudnn8-runtime
initialdir = /path/to/home
executable = $(project_dir)/submit_files/uv_run.sh
arguments = scripts/task2.py --output $(data_dir)/runs/task2/$(run_label).$(ClusterId).$(ProcId).h5 --device cuda $(model_args)
environment = "PROJECT_DIR=$(project_dir) DATA_DIR=$(data_dir) UV_PROJECT_ENVIRONMENT=$(data_dir)/venvs/nnti-project"
should_transfer_files = NO
getenv = HOME
+WantGPUHomeMounted = true

output = $(data_dir)/logs/task2.$(ClusterId).$(ProcId).out
error = $(data_dir)/logs/task2.$(ClusterId).$(ProcId).err
log = $(data_dir)/logs/task2.$(ClusterId).$(ProcId).log

request_cpus = 4
request_memory = 24G
request_gpus = 1
requirements = (GPUs_GlobalMemoryMb >= 12000)

queue 1
