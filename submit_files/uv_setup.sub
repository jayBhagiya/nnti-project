# Run once before task jobs. Create the parent directories before submission:
# mkdir -p /path/to/large-storage/nnti-project/{logs,runs,wandb,cache,venvs,python,tools}

project_dir = /path/to/nnti-project
data_dir = /path/to/large-storage/nnti-project

universe = docker
docker_image = pytorch/pytorch:2.2.2-cuda11.8-cudnn8-runtime
initialdir = /path/to/home
executable = $(project_dir)/submit_files/uv_setup.sh
environment = "PROJECT_DIR=$(project_dir) DATA_DIR=$(data_dir)"
should_transfer_files = NO
getenv = HOME
+WantGPUHomeMounted = true

output = $(data_dir)/logs/uv-setup.$(ClusterId).$(ProcId).out
error = $(data_dir)/logs/uv-setup.$(ClusterId).$(ProcId).err
log = $(data_dir)/logs/uv-setup.$(ClusterId).$(ProcId).log

request_cpus = 4
request_memory = 12G
request_gpus = 0

queue 1
