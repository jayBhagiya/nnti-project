project_dir = /path/to/nnti-project
data_dir = /path/to/large-storage/nnti-project

universe = docker
docker_image = pytorch/pytorch:2.2.2-cuda11.8-cudnn8-runtime
initialdir = $(project_dir)
executable = $(project_dir)/submit_files/uv_run.sh
arguments = scripts/lm_eval.py --device cuda --max-samples 200 --seed 42 --output $(data_dir)/runs/task1/metrics.$(ClusterId).$(ProcId).csv
environment = "PROJECT_DIR=$(project_dir) DATA_DIR=$(data_dir) UV_PROJECT_ENVIRONMENT=$(data_dir)/venvs/nnti-project"
should_transfer_files = NO
getenv = HOME
+WantGPUHomeMounted = true

output = $(data_dir)/logs/task1.$(ClusterId).$(ProcId).out
error = $(data_dir)/logs/task1.$(ClusterId).$(ProcId).err
log = $(data_dir)/logs/task1.$(ClusterId).$(ProcId).log

request_cpus = 4
request_memory = 16G
request_gpus = 1
requirements = (GPUs_GlobalMemoryMb >= 12000)

queue 1
